 "traps": [
  {
   "q": "T5B02",
   "wrong": "1500 MHz",
   "why": "Mega is a million, so 1,500,000 Hz is only 1.5 MHz. In kilo it is 1500 kHz."
  },
  {
   "q": "T5B04",
   "wrong": "One one-thousandth of a volt",
   "why": "That is a millivolt. Micro is one-millionth."
  },
  {
   "q": "T5B07",
   "wrong": "0.003525 kHz",
   "why": "Going to a smaller unit makes the number bigger: 3.525 x 1000 = 3525 kHz."
  },
  {
   "q": "T5B08",
   "wrong": "1000 microfarads",
   "why": "Pico is a million times smaller than micro, so a million pF is just 1 µF."
  },
  {
   "q": "T5B12",
   "wrong": "2.800 MHz",
   "why": "Dividing by 1000 moves the point three places: 28400 kHz = 28.400 MHz."
  },
  {
   "q": "T5C06",
   "wrong": "KHz",
   "why": "Capital K is not the kilo symbol. Kilo is a lowercase k, hertz a capital H: kHz."
  },
  {
   "q": "T5C07",
   "wrong": "mHz",
   "why": "Lowercase m means milli, a thousandth. Mega is a capital M: MHz."
  }
