 "compare": [
  {
   "term": "Resistors and inductors",
   "how": "Series adds. Parallel gives less than the smallest part."
  },
  {
   "term": "Capacitors",
   "how": "Parallel adds. Series gives less than the smallest part."
  },
  {
   "term": "Shortcuts",
   "how": "Two parts: product over sum. Equal parts: one value divided by how many."
  },
  {
   "term": "Reciprocals",
   "how": "1 / total = 1/A + 1/B + 1/C. The total always ends up smaller than the smallest part."
  }
 ],
 "traps": [
  {
   "q": "G5C09",
   "wrong": "300 microfarads",
   "why": "Adding is for capacitors in parallel. In series, equal capacitors divide: 100 / 3 = 33.3."
  },
  {
   "q": "G5C12",
   "wrong": "70 microfarads",
   "why": "In series, capacitors combine like parallel resistors: 1000 / 70 = 14.3."
  },
  {
   "q": "G5C10",
   "wrong": "30 millihenries",
   "why": "Inductors add in series, not parallel. In parallel: 10 / 3 = 3.3 mH."
  },
  {
