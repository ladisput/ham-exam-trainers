  {
   "term": "k = kilo",
   "how": "A thousand. Always a lowercase k: kHz."
  },
  {
   "term": "M = mega",
   "how": "A million. Capital M: MHz."
  },
  {
   "term": "m = milli",
   "how": "One-thousandth. Lowercase m: mA, mW."
  },
  {
   "term": "µ = micro",
