 "traps": [
  {
   "q": "T5D01",
   "wrong": "I = E x R",
   "why": "More resistance means less current, so current must be E divided by R."
  },
  {
   "q": "T5D02",
   "wrong": "E = I2 x R",
   "why": "There are no squares in Ohm's law. It is just E = I x R."
  },
  {
   "q": "T5D04",
   "wrong": "270 ohms",
   "why": "That is 90 x 3. Resistance is volts divided by amps: 90 / 3 = 30 ohms."
  },
  {
   "q": "T5D07",
   "wrong": "0.667 amperes",
   "why": "That is 80 / 120, upside down. Volts go on top: 120 / 80 = 1.5 A."
  },
  {
   "q": "T5D07",
   "wrong": "9600 amperes",
   "why": "That is 120 x 80. Current is volts divided by ohms."
  },
  {
   "q": "T5D10",
   "wrong": "0.25 volts",
   "why": "That is 0.5 / 2. Voltage is amps times ohms: 0.5 x 2 = 1 V."
  },
  {
   "q": "T5D11",
   "wrong": "11 volts",
   "why": "That is 10 + 1. Ohm's law multiplies or divides, it never adds."
  }
